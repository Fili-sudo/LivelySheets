        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Auth": {
        "SigningKey": "{from-secrets}",
        //"Issuer": "https://localhost:7131",
        "Issuer": "http://catalog-service:8080", //dockerized catalog-service
        //"Audience": "https://localhost:7131"
        "Audience": "http://catalog-service:8080" //dockerized catalog-service
